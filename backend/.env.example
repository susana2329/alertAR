# Completar en EC2. No incluir secretos en el paquete ni en Git.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# El APK Android usa https://localhost. Agregar aquí otros orígenes web reales, separados por comas.
CORS_ORIGINS=https://localhost
TRUST_PROXY_LOOPBACK=true

USER_DB_MONGO_DB=
PASSWORD_DB_MONGO_DB=
NAME_DB_MONGO_DB=alertar
APP_NAME_MONGO_DB=AlertAR-EC2

JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AWS_REGION=
S3_BUCKET=
ACCESSKEYID=
SECRETACCESSKEY=
# Solo si las credenciales AWS son temporales.
SESSIONTOKEN=

# Activar después de revisar la consulta de retención y confirmar acceso a S3.
RETENCION_AUTOMATICA=false
# Intervalo de ingesta oficial, en milisegundos (opcional).
INGESTA_INTERVALO_MS=900000
